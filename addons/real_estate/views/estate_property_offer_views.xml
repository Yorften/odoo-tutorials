<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="estate_property_offer_view_search" model="ir.ui.view">
        <field name="name">estate.property.offer.view.search</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id" />
                <field name="property_id" />
                <field name="price" />
                <filter name="group_by_property" string="Property"
                    context="{'group_by': 'property_id'}" />
            </search>
        </field>
    </record>

    <record id="estate_property_offer_view_form" model="ir.ui.view">
        <field name="name">estate.property.offer.view.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form string="Real Estate">
                <sheet>
                    <group>
                        <field name="partner_id" />
                        <field name="property_id" />
                        <field name="price" />
                    </group>
                    <group>
                        <field name="validity" />
                        <field name="date_deadline" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="estate_property_offer_view_list" model="ir.ui.view">
        <field name="name">estate.property.offer.view.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Real Estate">
                <field name="price" />
                <field name="property_id" />
                <field name="partner_id" />
                <field name="property_type_id" />
                <field name="validity" />
                <field name="date_deadline" />
                <field name="status" />
            </list>
        </field>
    </record>

    <record id="estate_property_offer_view_list_buttons" model="ir.ui.view">
        <field name="name">estate.property.offer.view.list.buttons</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list string="Real Estate">
                <field name="price" />
                <field name="property_id" />
                <field name="partner_id" />
                <field name="property_type_id" />
                <field name="validity" />
                <field name="date_deadline" />
                <button icon="fa-check" title="test" type="object" name="action_accept"
                    invisible=" status == 'accepted' or property_state == 'canceled' or property_state == 'sold' " />
                <button icon="fa-times" title="test" type="object" name="action_refuse"
                    invisible=" status == 'accepted' or property_state == 'canceled' or property_state == 'sold' " />
                <button icon="fa-undo" title="test" type="object" name="action_undo"
                    invisible=" status != 'accepted' or property_state == 'canceled' or property_state == 'sold' " />
                <field name="status" />
            </list>
        </field>
    </record>

    <record id="estate_property_offer_action" model="ir.actions.act_window">
        <field name="name">Property Offers</field>
        <field name="res_model">estate.property.offer</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>