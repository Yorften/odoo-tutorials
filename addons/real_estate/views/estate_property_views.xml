<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.view.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="postcode" />
                <field name="bedrooms" />
                <field name="living_area" />
                <field name="expected_price" />
                <field name="facades" />
                <field name="state" invisible="1" />
                <filter name="filter_state_new" string="New Properties"
                    domain="[('state', '=', 'new')]" />
                <filter name="filter_state_offer" string="Offer Recieved"
                    domain="[('state', '=', 'recieved')]" />
                <filter name="group_by_postcode" string="Postcode"
                    context="{'group_by': 'postcode'}" />
            </search>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.view.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Real Estate">
                <sheet>
                    <group>
                        <h1>
                            <p>Name :</p>
                            <field name="name" />
                        </h1>
                    </group>
                    <group>
                        <field name="tag_ids" widget="many2many_tags" />
                    </group>
                    <group>
                        <group>
                            <field name="property_type_id" />
                            <field name="postcode" />
                            <field name="date_availability" />
                        </group>
                        <group>
                            <field name="expected_price" />
                            <field name="best_offer" />
                            <field name="selling_price" />
                            <field name="state" />
                        </group>
                    </group>
                    <notebook>
                        <page name="page_1" string="Description">
                            <group name="description">
                                <field name="description" />
                                <field name="bedrooms" />
                                <field name="living_area" />
                                <field name="garage" />
                                <field name="garden" />
                                <field name="garden_area"
                                    readonly="garden" />
                                <field name="garden_orientation" />
                                <field name="total_area" />
                            </group>
                        </page>
                        <page name="page_2" string="Other Info">
                            <group>
                                <field name="salesperson_id" />
                                <field name="buyer_id" />
                            </group>
                        </page>
                        <page name="page_3" string="Offers">
                            <group>
                                <field name="offer_ids" invisible="selling_price != 0">
                                    <list string="Real Estate">
                                        <field name="price" />
                                        <field name="property_id" />
                                        <field name="partner_id" />
                                        <field name="property_type_id" />
                                        <field name="validity" />
                                        <field name="date_deadline" />
                                        <button icon="fa-check" title="test" type="object" name="action_accept"
                                            invisible=" status == 'accepted' " />
                                        <button icon="fa-times" title="test" type="object" name="action_refuse"
                                            invisible=" status == 'accepted' " />
                                        <button icon="fa-undo" title="test" type="object" name="action_undo"
                                            invisible=" status != 'accepted' " />
                                        <field name="status" />
                                    </list>
                                </field>
                                <field name="offer_ids" invisible="selling_price == 0">
                                    <list string="Real Estate" create="0">
                                        <field name="price" />
                                        <field name="property_id" />
                                        <field name="partner_id" />
                                        <field name="property_type_id" />
                                        <field name="validity" />
                                        <field name="date_deadline" />
                                        <button icon="fa-check" title="test" type="object" name="action_accept"
                                            invisible=" status == 'accepted' " />
                                        <button icon="fa-times" title="test" type="object" name="action_refuse"
                                            invisible=" status == 'accepted' " />
                                        <button icon="fa-undo" title="test" type="object" name="action_undo"
                                            invisible=" status != 'accepted' " />
                                        <field name="status" />
                                    </list>
                                </field>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.view.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Real Estate">
                <field name="name" />
                <field name="postcode" />
                <field name="bedrooms" />
                <field name="living_area" />
                <field name="expected_price" />
                <field name="selling_price" />
                <field name="date_availability" />
            </list>
        </field>
    </record>

    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">View Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>