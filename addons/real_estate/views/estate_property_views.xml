<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="estate_property_view_search" model="ir.ui.view">
        <field name="name">estate.property.view.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="postcode" />
                <field name="bedrooms" />
                <field name="living_area" />
                <field name="expected_price" />
                <field name="facades" />
                <field name="state" invisible="1" />
                <filter name="filter_state_new" string="New Properties"
                    domain="[('state', '=', 'new')]" />
                <filter name="filter_state_offer" string="Offer Recieved"
                    domain="[('state', '=', 'recieved')]" />
                <filter name="group_by_postcode" string="Postcode"
                    context="{'group_by': 'postcode'}" />
            </search>
        </field>
    </record>

    <record id="estate_property_view_form" model="ir.ui.view">
        <field name="name">estate.property.view.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Real Estate">
                <sheet>
                    <header>
                        <field name="state" widget="statusbar" />
                    </header>
                    <group>
                        <group>
                            <h1>
                                <p>Name :</p>
                                <field name="name" />
                            </h1>
                        </group>
                    </group>
                    <group>
                        <field name="tag_ids" widget="many2many_tags" />
                    </group>
                    <group>
                        <group>
                            <field name="property_type_id" />
                            <field name="postcode" />
                            <field name="date_availability" />
                        </group>
                        <group>
                            <field name="expected_price" />
                            <field name="best_offer" />
                            <field name="selling_price" />
                            <button type="object" name="action_sold"
                                invisible=" state != 'accepted' ">
                                Sold
                            </button>
                            <button title="test" type="object" name="action_cancel"
                                invisible=" state == 'sold' or state == 'canceled' or state == 'accepted' ">
                                Cancel
                            </button>
                            <button icon="fa-undo" title="test" type="object" name="action_undo"
                                invisible=" state == 'new' or state == 'recieved' or state == 'accepted' ">
                                Undo
                            </button>
                        </group>
                    </group>
                    <notebook>
                        <page name="page_1" string="Description">
                            <group name="description">
                                <field name="description" />
                                <field name="bedrooms" />
                                <field name="living_area" />
                                <field name="garage" />
                                <field name="garden" />
                                <field name="garden_area" readonly="garden == False" />
                                <field name="garden_orientation" readonly="garden == False" />
                                <field name="total_area" />
                            </group>
                        </page>
                        <page name="page_2" string="Other Info">
                            <group>
                                <field name="salesperson_id" />
                                <field name="buyer_id" />
                            </group>
                        </page>
                        <page name="page_3" string="Offers">
                            <group>
                                <field name="offer_ids" readonly=" selling_price != 0 "
                                    context="{'list_view_ref' : 'real_estate.estate_property_offer_view_list_buttons'}" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>


    <record id="estate_property_view_list" model="ir.ui.view">
        <field name="name">estate.property.view.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list string="Real Estate">
                <field name="name" />
                <field name="postcode" />
                <field name="bedrooms" />
                <field name="living_area" />
                <field name="expected_price" />
                <field name="selling_price" />
                <field name="date_availability" />
            </list>
        </field>
    </record>

    <record id="estate_property_action" model="ir.actions.act_window">
        <field name="name">View Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>