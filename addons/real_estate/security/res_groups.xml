<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data noupdate="1">
        <!-- Group: Real Estate Agent -->
        <record id="estate_group_user" model="res.groups">
            <field name="name">Agent</field>
        </record>

        <!-- Group: Real Estate Manager -->
        <record id="estate_group_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="implied_ids" eval="[(4, ref('estate_group_user'))]" />
        </record>

        <!-- Restricting Access for Agents -->
        <record id="rule_agent_property_access" model="ir.rule">
            <field name="name">Agent Access to Properties</field>
            <field name="model_id" ref="real_estate.model_estate_property" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="False" />
            <field name="global" eval="True" />
            <field name="groups" eval="[Command.link(ref('estate_group_user'))]" />
            <field name="domain_force">[
                '|',
                ('salesperson_id', '=', user.id),
                ('salesperson_id', '=', False)
                ]</field>
        </record>
        <!-- Manager can see and edit all properties-->
        <record id="rule_manager_property_access" model="ir.rule">
            <field name="name">Manager Access to Properties</field>
            <field name="model_id" ref="real_estate.model_estate_property" />
            <field name="perm_read" eval="True" />
            <field name="perm_write" eval="True" />
            <field name="perm_create" eval="True" />
            <field name="perm_unlink" eval="True" />
            <field name="groups" eval="[Command.link(ref('estate_group_manager'))]" />
            <field name="domain_force">[]</field>
        </record>
    </data>
</odoo>