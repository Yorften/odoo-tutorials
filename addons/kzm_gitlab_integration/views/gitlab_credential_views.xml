<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_gitlab_credentials_list" model="ir.ui.view">
        <field name="name">gitlab.credential.list</field>
        <field name="model">gitlab.credential</field>
        <field name="arch" type="xml">
            <list>
                <field name="token_name" />
            </list>
        </field>
    </record>

    <record id="gitlab_credential_view_kanban" model="ir.ui.view">
        <field name="name">gitlab.credential.kanban</field>
        <field name="model">gitlab.credential</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="token_name" />
                <field name="active_token" />
                <templates>
                    <t t-name="card">
                        <div class="row">
                            <div class="col-8">
                                <field class="fw-bolder" name="token_name" />
                            </div>
                            <div t-if="record.active_token.raw_value" class="col-4 text-end">
                                <span class="badge text-bg-success">Active</span>
                            </div>
                        </div>
                        <div>
                            <strong>Token Validity: </strong>
                            <field name="state" />
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="gitlab_credential_view_form" model="ir.ui.view">
        <field name="name">gitlab.credential.view.form</field>
        <field name="model">gitlab.credential</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button type="object" name="action_verify_credentials">
                        Verify
                    </button>
                    <field name="state" widget="statusbar" statusbar_visible="active,inactive" />
                </header>
                <sheet>
                    <group>
                        <field name="token_name" />
                        <field name="access_token" password="True" />
                    </group>
                    <group>
                        <button type="object" name="action_mark_as_active">
                            Mark as active
                        </button>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="github_credential_action" model="ir.actions.act_window">
        <field name="name">Gitlab Credentials</field>
        <field name="res_model">gitlab.credential</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>