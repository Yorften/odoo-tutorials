<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="estate_property_tag_view_search" model="ir.ui.view">
        <field name="name">odoo.version.view.search</field>
        <field name="model">odoo.version</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
            </search>
        </field>
    </record>

    <record id="project_database_view_form" model="ir.ui.view">
        <field name="name">odoo.version.view.form</field>
        <field name="model">odoo.version</field>
        <field name="arch" type="xml">
            <form string="Odoo Versions">
                <sheet>
                    <group>
                        <h1>
                            <p>Version :</p>
                            <field name="name" />
                        </h1>
                        <field name="color" widget="color"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>


    <record id="project_database_view_list" model="ir.ui.view">
        <field name="name">odoo.version.view.list</field>
        <field name="model">odoo.version</field>
        <field name="arch" type="xml">
            <list default_order="name">
                <field name="name" />
            </list>
        </field>
    </record>


    <record id="odoo_version_action" model="ir.actions.act_window">
        <field name="name">Odoo Versions</field>
        <field name="res_model">odoo.version</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>