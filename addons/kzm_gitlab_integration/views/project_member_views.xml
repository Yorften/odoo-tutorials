<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_member_action" model="ir.actions.act_window">
        <field name="name">Project Members</field>
        <field name="res_model">gitlab.member</field>
        <field name="view_mode">list</field>
    </record>

    <record id="project_member_view_list" model="ir.ui.view">
        <field name="name">gitlab.member.view.list</field>
        <field name="model">gitlab.member</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name" />
            </list>
        </field>
    </record>

</odoo>