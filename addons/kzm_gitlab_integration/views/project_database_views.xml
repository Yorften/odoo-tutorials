<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_database_action" model="ir.actions.act_window">
        <field name="name">Projects</field>
        <field name="res_model">gitlab.project</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="project_database_view_list" model="ir.ui.view">
        <field name="name">gitlab.project.view.list</field>
        <field name="model">gitlab.project</field>
        <field name="arch" type="xml">
            <list string="GitLab Projects">
                <field name="name" />
                <field name="position" />
                <field name="pipeline_status" />
                <field name="code_score" />
                <field name="branches" />
            </list>
        </field>
    </record>


    <record id="project_database_view_form" model="ir.ui.view">
        <field name="name">gitlab.project.view.form</field>
        <field name="model">gitlab.project</field>
        <field name="arch" type="xml">
            <form string="GitLab Project">
                <sheet>
                    <header>
                        <button type="object" name="action_sync_project" string="Sync" />
                        <field name="position" widget="statusbar" options="{'clickable':1}" />
                    </header>
                    <group>
                        <h1>
                            <p>Project Name :</p>
                            <field name="project_name" />
                        </h1>
                    </group>
                    <group>
                        <group>
                            <field name="name" readonly="True" />
                            <field name="link" readonly="True" widget="url" options="{'target': '_blank'}" />
                            <field name="git_link" readonly="True" widget="clipboard_url" options="{'target': '_blank'}" />
                            <field name="pipeline_status" readonly="True" />
                            <field name="odoo_version_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="GitLab Info">
                            <group>
                                <field name="group" readonly="True" />
                                <field name="default_branch" readonly="True" />
                                <field name="branches" readonly="True" />
                                <field name="code_score" readonly="True" />
                                <field name="last_merge" readonly="True" />
                            </group>
                        </page>

                        <page string="Project Members">
                            <field name="project_members_ids" widget="many2many_tags"
                                readonly="True"
                                placeholder="No members assigned." />
                        </page>

                        <page string="Description">
                            <group>
                                <field name="description" readonly="True" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

</odoo>