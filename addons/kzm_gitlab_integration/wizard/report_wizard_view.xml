<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="wizard_report_view_form" model="ir.ui.view">
        <field name="name">report.wizard.form</field>
        <field name="model">report.wizard</field>
        <field name="arch" type="xml">
            <form string="Download Report">
                <group>
                    <field name="report_type" />
                </group>
                <footer>
                    <button string="Download" type="object" name="action_download_report" class="oe_highlight" />
                    <button string="Cancel" class="btn-default" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

</odoo>