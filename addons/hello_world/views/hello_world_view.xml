<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hello_world_form" model="ir.ui.view">
        <field name="name">hello.world.form.view</field>
        <field name="model">hello.world</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hello_world_tree" model="ir.ui.view">
        <field name="name">hello.world.tree.view</field>
        <field name="model">hello.world</field>
        <field name="arch" type="xml">
            <list>
                <field name="name" />
            </list>
        </field>
    </record>

    <!-- Action to open the view -->
    <record id="action_hello_world" model="ir.actions.act_window">
        <field name="name">Hello World</field>
        <field name="res_model">hello.world</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_hello_world_root"
        name="Hello World"
        sequence="280">
        <menuitem id="menu_hello_world"
            name="Hello World"
            sequence="10">
            <menuitem id="menu_student_records"
                name="Show data"
                action="action_hello_world"
                sequence="9" />
            <menuitem id="menu_student_test"
                name="Hello World"
                action="action_hello_world"
                sequence="10" />
        </menuitem>
    </menuitem>

</odoo>